# Core local application configuration
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/tore?schema=public
AUTH_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=TORE
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local development storage and email defaults
FILE_STORAGE=local
FILE_STORAGE_LOCAL_ROOT=.data/uploads
ARCHIVE_STORAGE=local
ARCHIVE_LOCAL_ROOT=.data/legal-archive
ARCHIVE_S3_PREFIX=legal-archive
EMAIL_PROVIDER=console
EMAIL_FROM=TORE <noreply@tore.mn>
EMAIL_VERIFICATION_TTL_HOURS=24

# Optional: enables Legal AI completions.
OPENAI_API_KEY=

# Optional: enables distributed rate limiting outside local development.
REDIS_URL=

# Optional: enables Resend email delivery.
RESEND_API_KEY=

# Optional: enables SMTP email delivery when EMAIL_PROVIDER=smtp.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Optional: enables the internal legal-data engine.
ENGINE_BASE_URL=
ENGINE_SERVICE_TOKEN=
ENGINE_TIMEOUT_MS=8000

# Optional: use object storage for user uploads when FILE_STORAGE=s3.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_BASE_URL=

# Optional: use object storage for legal-source archives when ARCHIVE_STORAGE=s3.
# ARCHIVE_S3_BUCKET falls back to S3_BUCKET when unset.
ARCHIVE_S3_BUCKET=

# Optional: enables QPay Sandbox checkout and payment E2E.
QPAY_BASE_URL=https://merchant-sandbox.qpay.mn
QPAY_CLIENT_ID=
QPAY_CLIENT_SECRET=
QPAY_CALLBACK_URL=http://localhost:3000/api/billing/qpay/callback
QPAY_INVOICE_CODE=

# Optional E2E overrides. The QPay E2E suite creates test users if these are unset.
TORE_E2E_BASE_URL=http://localhost:3000
QPAY_E2E_PAYMENT_WAIT_MS=300000
QPAY_E2E_POLL_MS=5000
QPAY_E2E_SKIP_PAYMENT=false
QPAY_E2E_LAWYER_EMAIL=
QPAY_E2E_LAWYER_PASSWORD=
QPAY_E2E_CITIZEN_BASIC_EMAIL=
QPAY_E2E_CITIZEN_PLUS_EMAIL=
QPAY_E2E_CITIZEN_PASSWORD=
